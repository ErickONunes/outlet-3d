# Set these values in a local .env file for non-production testing.
# The production publisher ID is defined in .env.production.
PUBLIC_ADSENSE_ENABLED=false
PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# Optional: create a display ad unit in AdSense and place its numeric slot ID here.
PUBLIC_ADSENSE_ARTICLE_SLOT=
# GA4 Measurement ID. This is public, but never put API secrets in this file.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
