---
// Render only after configuring valid IDs and reviewing consent requirements.
const {slot}=Astro.props;
const client=import.meta.env.PUBLIC_ADSENSE_CLIENT;
const enabled=import.meta.env.PUBLIC_ADSENSE_ENABLED==='true' && /^ca-pub-\d{16}$/.test(client || '') && /^\d+$/.test(slot || '');
---
{enabled && <aside aria-label="Publicidade" style="min-height:280px;margin:32px 0;text-align:center"><span style="font-size:12px;color:#6b736c">Publicidade</span><ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(window.adsbygoogle=window.adsbygoogle||[]).push({});</script></aside>}
