---
import { webStories } from '../../data/webStories';
export function getStaticPaths() { return webStories.map(story => ({ params: { slug: story.slug }, props: { story } })); }
const { story } = Astro.props;
const canonical = `https://outlet3d.com.br/web-stories/${story.slug}/`;
const schema = {'@context':'https://schema.org','@type':'Article',headline:story.title,description:story.description,image:`https://outlet3d.com.br${story.image}`,author:{'@type':'Person',name:'Erick Nunes'},publisher:{'@type':'Organization',name:'Outlet 3D'},mainEntityOfPage:canonical,datePublished:'2024-08-14',dateModified:'2026-09-17',inLanguage:'pt-BR'};
const boilerplate = 'body{-webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-moz-animation:-amp-start 8s steps(1,end) 0s 1 normal both;animation:-amp-start 8s steps(1,end) 0s 1 normal both}@keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}';
const customCss = '.fill{object-fit:cover}.brand{color:#18d7e3;font:700 12px Arial;letter-spacing:2px}.copy{align-content:end;background:linear-gradient(0deg,rgba(11,16,32,.97),rgba(11,16,32,.05) 75%);box-sizing:border-box;color:#fff;padding:34px}.copy h1{font:700 37px/1.04 Arial;margin:10px 0}.copy p{font:400 19px/1.42 Arial;margin:0}.copy .kicker{color:#ff9d2e;font:800 11px Arial;letter-spacing:1.5px}.outro{align-content:end;background:#0b1020;box-sizing:border-box;color:#fff;padding:34px}.outro h2{font:700 34px/1.08 Arial;margin:12px 0}.outro p{color:#c9d2e7;font:18px/1.5 Arial}.outro a{background:#fff;color:#0b1020;display:inline-block;font:700 15px Arial;margin-top:18px;padding:14px 18px;text-decoration:none}';
---
<!doctype html><html amp lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1"/><script async src="https://cdn.ampproject.org/v0.js"></script><script async custom-element="amp-story" src="https://cdn.ampproject.org/v0/amp-story-1.0.js"></script><title>{story.title} | Outlet 3D</title><meta name="description" content={story.description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="article"/><meta property="og:title" content={story.title}/><meta property="og:description" content={story.description}/><meta property="og:image" content={`https://outlet3d.com.br${story.image}`}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')}/><style amp-boilerplate set:html={boilerplate}/><noscript><style amp-boilerplate set:html="body{-webkit-animation:none;-moz-animation:none;animation:none}"/></noscript><style amp-custom set:html={customCss}/></head><body><amp-story standalone publisher="Outlet 3D" publisher-logo-src="https://outlet3d.com.br/favicon.svg" title={story.title} poster-portrait-src={`https://outlet3d.com.br${story.image}`}>{story.slides.map((slide,index)=><amp-story-page id={`slide-${index + 1}`}><amp-story-grid-layer template="fill"><amp-img class="fill" src={`https://outlet3d.com.br${story.image}`} width="640" height="853" layout="responsive" alt=""></amp-img></amp-story-grid-layer><amp-story-grid-layer class="copy" template="vertical"><div><p class="brand">OUTLET 3D</p><p class="kicker">{slide.kicker}</p><h1>{slide.title}</h1><p>{slide.text}</p></div></amp-story-grid-layer></amp-story-page>)}<amp-story-page id="continue"><amp-story-grid-layer template="fill"><amp-img class="fill" src={`https://outlet3d.com.br${story.image}`} width="640" height="853" layout="responsive" alt=""></amp-img></amp-story-grid-layer><amp-story-grid-layer class="outro" template="vertical"><div><p class="brand">CONTINUE EXPLORANDO</p><h2>Quer se aprofundar?</h2><p>Leia o guia completo e descubra mais projetos da Outlet 3D.</p><a href={`https://outlet3d.com.br${story.article}`}>Ler conteúdo completo ↗</a></div></amp-story-grid-layer></amp-story-page></amp-story></body></html>
