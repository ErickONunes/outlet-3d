---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import migrated from '../data/migrated.json';
import { articles, categories, categorySlug, photos } from '../data/articles';
import '../styles/home.css';
const pilotArticles = migrated.filter(a => a.kind === 'post');
const featured = articles[0];
const featuredMigration = pilotArticles[0];
---
<Layout title="Impressão 3D, ideias e possibilidades | Outlet 3D">
  <main class="home-page">
    <section class="home-hero">
      <div class="home-hero-copy"><p class="eyebrow"><span></span> IMPRESSÃO 3D PARA QUEM QUER CRIAR</p><h1>A imaginação é o início.<br /><em>O próximo passo é real.</em></h1><p class="home-hero-lead">Conhecimento, referências e projetos para levar suas ideias da tela para as suas mãos.</p><div class="home-hero-actions"><a href="#em-destaque">Explorar conteúdos <span>↓</span></a><a href="/artigos/primeira-impressao-3d/">Começar do zero <span>↗</span></a></div></div>
      <a class="home-hero-art" href={`/artigos/${featured.slug}/`} aria-label={`Ler ${featured.title}`}><img src={photos[0]} alt="Impressora 3D produzindo uma peça vermelha" fetchpriority="high" width="1600" height="1000" /><span class="home-hero-art-shade"></span><span class="home-hero-art-label">FABRICAÇÃO<br />ADITIVA <b>01</b></span><span class="home-hero-art-arrow">↗</span></a>
      <div class="home-hero-caption"><span>DESIGN · TECNOLOGIA · CRIAÇÃO</span><p>Uma revista para a era em que qualquer ideia pode ganhar forma.</p></div>
    </section>
    <section class="home-manifesto"><div><p class="eyebrow">UMA NOVA FORMA DE FAZER</p><h2>Não é só sobre imprimir objetos.<br />É sobre ampliar o que você é capaz de <em>imaginar.</em></h2></div><div><p>A Outlet 3D traduz o universo da fabricação aditiva em conteúdo que inspira e orienta cada nova camada da sua jornada.</p><a href="/sobre/">Conheça nossa visão <span>↗</span></a></div></section>
    <section class="home-feature" id="em-destaque"><div class="home-section-heading"><p class="eyebrow"><span></span> EM DESTAQUE</p><h2>O que está movimentando o universo 3D.</h2></div><div class="home-feature-grid"><a class="home-feature-main" href={featuredMigration.path}>{featuredMigration.cover && <img src={featuredMigration.cover.src} alt={featuredMigration.cover.alt} width={featuredMigration.cover.width} height={featuredMigration.cover.height} loading="lazy" />}<span class="home-feature-main-shade"></span><div><span class="home-tag">{featuredMigration.categories[0]?.name ?? 'Impressão 3D'}</span><h3>{featuredMigration.title}</h3><p>{featuredMigration.excerpt.slice(0, 145)}…</p><span class="home-read">Ler artigo <b>↗</b></span></div></a><div class="home-feature-list">{pilotArticles.slice(1, 4).map((article, index) => <a href={article.path}><span class="home-index">0{index + 2}</span><div><span class="category">{article.categories[0]?.name ?? 'Impressão 3D'}</span><h3>{article.title}</h3><p>{article.readingMinutes} min de leitura</p></div><span class="home-list-arrow">↗</span></a>)}</div></div></section>
    <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_ARTICLE_SLOT}/>
    <section class="home-paths"><div><p class="eyebrow">ENCONTRE O SEU PONTO DE PARTIDA</p><h2>Todo criador começa por uma <em>pergunta.</em></h2></div><div class="home-path-cards">{categories.slice(0, 3).map((category, index) => <a href={`/categoria/${categorySlug(category)}/`}><span>0{index + 1}</span><h3>{category}</h3><p>{['Aprenda os fundamentos, configurações e processos que dão segurança para começar.', 'Entenda tendências, aplicações e as ideias que estão mudando a forma de produzir.', 'Leve sua referência além: crie, personalize e transforme conceitos em peças.'][index]}</p><b>↗</b></a>)}</div></section>
    <section class="home-latest"><div class="home-section-heading home-latest-heading"><div><p class="eyebrow"><span></span> DO ACERVO OUTLET 3D</p><h2>Ideias para sua próxima criação.</h2></div><a href="/categoria/guias-tutoriais/">Ver todos os guias <span>↗</span></a></div><div class="home-article-grid">{pilotArticles.slice(4, 10).map(article => <article><a class="home-article-image" href={article.path}>{article.cover && <img src={article.cover.src} alt={article.cover.alt} width={article.cover.width} height={article.cover.height} loading="lazy" />}</a><span class="category">{article.categories.map(c => c.name).join(' · ')}</span><h3><a href={article.path}>{article.title}</a></h3><p>{article.excerpt.slice(0, 120)}…</p><a class="home-article-link" href={article.path}>Ler agora <span>↗</span></a></article>)}</div></section>
    <section class="home-final-cta"><div><p class="eyebrow">A PRÓXIMA CAMADA É SUA</p><h2>Transforme curiosidade em <em>criação.</em></h2></div><a href="/artigos/primeira-impressao-3d/">Começar a explorar <span>↗</span></a></section>
  </main>
</Layout>
