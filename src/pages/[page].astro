---
import Layout from '../layouts/Layout.astro';
import '../styles/editorial.css';
import '../styles/author.css';
import '../styles/institutional.css';
const pages={privacidade:{title:'Privacidade',lead:'Como esta versão do site funciona.',sections:[['Navegação','Esta versão não possui cadastro, formulário de coleta de dados, ferramentas de análise ou anúncios ativos.'],['Contato por e-mail','Ao enviar uma mensagem, você compartilha os dados incluídos no e-mail para responder à sua solicitação.']]},termos:{title:'Termos de uso',lead:'Orientações para aproveitar o conteúdo da Outlet 3D.',sections:[['Finalidade educativa','O conteúdo tem caráter informativo. Confira a compatibilidade de equipamentos, materiais e configurações antes de aplicar um procedimento.'],['Contato','Dúvidas e solicitações podem ser encaminhadas para contato@outlet3d.com.br.']]} };
export function getStaticPaths(){return ['autor','privacidade','termos'].map(page=>({params:{page}}))}
const key=Astro.params.page as keyof typeof pages;
---
{Astro.params.page==='autor' ? <Layout title="Erick Nunes | Outlet 3D"><main class="author-page"><section class="author-hero"><div><p class="eyebrow"><span></span> AUTOR DA OUTLET 3D</p><h1>Erick<br /><em>Nunes.</em></h1><p>Engenheiro, pesquisador e comunicador movido pela capacidade de transformar uma ideia em algo real.</p><a href="https://www.linkedin.com/in/erickonunes/" target="_blank" rel="noopener noreferrer">Conectar no LinkedIn <span>↗</span></a></div><div class="author-portrait"><img src="/wp-content/uploads/2024/01/ErickNunes.webp" alt="Erick Nunes" width="512" height="512" loading="eager"/><span>EN</span></div></section><section class="author-story"><p class="eyebrow">CONHECIMENTO QUE APROXIMA</p><h2>Tecnologia faz mais sentido quando coloca mais pessoas para criar.</h2><div><p>Com formação em Engenharia Mecânica e experiência em pesquisa e desenvolvimento, Erick Nunes une conhecimento técnico e curiosidade para explorar o universo da fabricação aditiva.</p><p>Na Outlet 3D, ele compartilha guias, referências e ideias que tornam a impressão 3D mais acessível para iniciantes, profissionais e criadores.</p></div></section><section class="author-values"><article><span>01</span><h3>Engenharia</h3><p>Rigor técnico para entender processos, materiais e aplicações.</p></article><article><span>02</span><h3>Educação</h3><p>Conteúdo claro para transformar dúvida em autonomia.</p></article><article><span>03</span><h3>Inovação</h3><p>O olhar no futuro de quem acredita no poder de construir.</p></article></section></main></Layout> : <Layout title={pages[key].title} description={pages[key].lead}><main class="institutional-page"><header class="institutional-hero"><div class="breadcrumb"><a href="/">Início</a> / {pages[key].title}</div><p class="eyebrow"><span></span> OUTLET 3D · INFORMAÇÕES INSTITUCIONAIS</p><h1>{pages[key].title}</h1><p>{pages[key].lead}</p></header><div class="institutional-content">{pages[key].sections.map(([heading,body])=><section><h2>{heading}</h2><p>{body}</p></section>)}<p><a href="mailto:contato@outlet3d.com.br">contato@outlet3d.com.br ↗</a></p></div></main></Layout>}
