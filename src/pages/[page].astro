---
import Layout from '../layouts/Layout.astro';
import '../styles/editorial.css';
import '../styles/author.css';
import '../styles/author-portfolio.css';
import '../styles/institutional.css';
const pages={privacidade:{title:'Privacidade',lead:'Como esta versão do site funciona.',sections:[['Navegação','Esta versão não possui cadastro, formulário de coleta de dados, ferramentas de análise ou anúncios ativos.'],['Contato por e-mail','Ao enviar uma mensagem, você compartilha os dados incluídos no e-mail para responder à sua solicitação.']]},termos:{title:'Termos de uso',lead:'Orientações para aproveitar o conteúdo da Outlet 3D.',sections:[['Finalidade educativa','O conteúdo tem caráter informativo. Confira a compatibilidade de equipamentos, materiais e configurações antes de aplicar um procedimento.'],['Contato','Dúvidas e solicitações podem ser encaminhadas para contato@outlet3d.com.br.']]} };
export function getStaticPaths(){return ['autor','privacidade','termos'].map(page=>({params:{page}}))}
const key=Astro.params.page as keyof typeof pages;
---
{Astro.params.page==='autor' ? <Layout title="Erick Nunes | Tecnologia, estratégia e fabricação aditiva" description="Conheça Erick Nunes: fundador e CEO da Agência EON, profissional de tecnologia, marketing e autor da Outlet 3D."><main class="author-page"><section class="author-hero"><div class="author-hero-copy"><p class="eyebrow"><span></span> PORTFÓLIO · TECNOLOGIA & ESTRATÉGIA</p><p class="author-kicker">ERICK OLIVEIRA NUNES</p><h1>Ideias que<br/><em>movem projetos.</em></h1><p>Empreendedor, estrategista digital e autor. Erick une tecnologia, educação e fabricação aditiva para criar projetos que aproximam pessoas de novas possibilidades.</p><div class="author-hero-actions"><a class="author-primary-link" href="https://www.linkedin.com/in/erickonunes/" target="_blank" rel="noopener noreferrer">Ver perfil no LinkedIn <span>↗</span></a><a class="author-secondary-link" href="https://agenciaeon.com.br/sobre/" target="_blank" rel="noopener noreferrer">Conhecer a Agência EON</a></div></div><div class="author-portrait"><img src="/wp-content/uploads/2024/01/ErickNunes.webp" alt="Retrato de Erick Nunes" width="512" height="512" loading="eager"/><span>EN</span><small>ESTRATÉGIA · TECNOLOGIA · CRIAÇÃO</small></div></section><section class="author-intro"><p class="eyebrow">UMA TRAJETÓRIA PARA TIRAR PROJETOS DO PAPEL</p><h2>Do crescimento digital à cultura de criação.</h2><div><p>Com mais de duas décadas de atuação entre tecnologia, programação e marketing digital, Erick construiu uma carreira voltada a resolver desafios complexos com estratégia, produto e comunicação.</p><p>Como fundador e CEO da Agência EON, lidera iniciativas de marketing educacional e captação digital. Na Outlet 3D, leva esse olhar para o universo da fabricação aditiva: conteúdo direto, repertório técnico e incentivo para que mais pessoas criem.</p></div></section><section class="author-metrics" aria-label="Destaques da trajetória"><article><strong>+20</strong><span>anos entre tecnologia, programação e marketing digital</span></article><article><strong>2016</strong><span>Agência EON fundada para criar crescimento digital</span></article><article><strong>3D</strong><span>conteúdo, experimentação e fabricação aditiva na Outlet 3D</span></article></section><section class="author-work"><div class="author-work-heading"><p class="eyebrow">FRENTES DE ATUAÇÃO</p><h2>Projetos que conectam visão e execução.</h2></div><div class="author-work-grid"><article><span>01</span><h3>Agência EON</h3><p>Estratégia, tecnologia e marketing educacional para instituições que querem crescer com jornadas digitais mais claras.</p><a href="https://agenciaeon.com.br/sobre/" target="_blank" rel="noopener noreferrer">Conhecer a empresa <b>↗</b></a></article><article><span>02</span><h3>Outlet 3D</h3><p>Uma plataforma editorial para quem quer entender, testar e criar usando impressão 3D e fabricação aditiva.</p><a href="/">Explorar a Outlet 3D <b>↗</b></a></article><article><span>03</span><h3>Estratégia digital</h3><p>Experiência que integra posicionamento, conteúdo, produto e dados para transformar objetivos em iniciativas realizáveis.</p><a href="https://www.linkedin.com/in/erickonunes/" target="_blank" rel="noopener noreferrer">Acompanhar no LinkedIn <b>↗</b></a></article></div></section><section class="author-principles"><div><p class="eyebrow">O QUE ORIENTA O TRABALHO</p><h2>Curiosidade técnica. Clareza para decidir. Vontade de construir.</h2></div><ol><li><span>01</span><div><h3>Tecnologia a serviço de pessoas</h3><p>Ferramentas são valiosas quando tornam escolhas, processos e aprendizado mais acessíveis.</p></div></li><li><span>02</span><div><h3>Estratégia que chega à execução</h3><p>Uma boa visão ganha força quando se transforma em uma sequência clara de decisões e entregas.</p></div></li><li><span>03</span><div><h3>Conhecimento compartilhado</h3><p>Conteúdo útil abre espaço para mais autonomia, experimentação e projetos bem resolvidos.</p></div></li></ol></section><section class="author-contact"><p class="eyebrow">VAMOS CONVERSAR</p><h2>Tem uma ideia que merece ganhar forma?</h2><p>Conheça o trabalho de Erick ou entre em contato com a Outlet 3D.</p><div><a href="https://www.linkedin.com/in/erickonunes/" target="_blank" rel="noopener noreferrer">Conectar no LinkedIn <span>↗</span></a><a href="mailto:contato@outlet3d.com.br">Enviar uma mensagem</a></div></section></main></Layout> : <Layout title={pages[key].title} description={pages[key].lead}><main class="institutional-page"><header class="institutional-hero"><div class="breadcrumb"><a href="/">Início</a> / {pages[key].title}</div><p class="eyebrow"><span></span> OUTLET 3D · INFORMAÇÕES INSTITUCIONAIS</p><h1>{pages[key].title}</h1><p>{pages[key].lead}</p></header><div class="institutional-content">{pages[key].sections.map(([heading,body])=><section><h2>{heading}</h2><p>{body}</p></section>)}<p><a href="mailto:contato@outlet3d.com.br">contato@outlet3d.com.br ↗</a></p></div></main></Layout>}
