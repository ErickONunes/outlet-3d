---
import Layout from '../layouts/Layout.astro';
const pages={
 sobre:{title:'Sobre a Outlet 3D',lead:'Transformando ideias em realidade com a tecnologia 3D.',sections:[['Conhecimento que dá forma às ideias','Bem-vindo à Outlet 3D! Somos uma fonte de informação e inspiração para entusiastas da impressão 3D. Aqui, você encontra guias, produtos personalizados e ideias criativas de DIY para explorar o design e a fabricação aditiva.'],['Aprender, experimentar, criar','Nossa missão é tornar a impressão 3D mais acessível. Reunimos conteúdo para quem está começando e para quem quer ampliar suas possibilidades com prototipagem e customização.'],['Quem escreve','Erick Nunes compartilha sua paixão pela impressão 3D em conteúdos sobre tecnologia, design e produção aditiva. Seu compromisso com a educação orienta a proposta editorial da Outlet 3D.']]},
 autor:{title:'Erick Nunes',lead:'Autor da Outlet 3D. Curiosidade, design e paixão pela fabricação aditiva.',sections:[['Sobre o autor','Erick Nunes escreve sobre impressão 3D, prototipagem e customização. Seu trabalho na Outlet 3D aproxima conceitos técnicos de quem quer transformar ideias em objetos e explorar novas possibilidades de criação.'],['Conecte-se','Acompanhe Erick no LinkedIn ou entre em contato com a equipe para sugestões e correções.']]},
 contato:{title:'Vamos conversar?',lead:'Dúvidas, sugestões ou uma ideia para compartilhar?',sections:[['Fale com a Outlet 3D','Envie sua mensagem para contato@outlet3d.com.br. Para sugerir uma correção, inclua o título do artigo e o trecho que precisa ser revisado.'],['Parcerias','Propostas comerciais podem ser enviadas ao mesmo endereço. Conte sobre a empresa, o objetivo e o formato de colaboração.']]},
 transparencia:{title:'Transparência editorial',lead:'Informação clara para quem lê e para quem cria.',sections:[['Nosso conteúdo','Publicamos conteúdos educativos sobre impressão 3D. Guias introdutórios não substituem o manual da máquina, as fichas técnicas dos materiais ou a validação de um projeto específico.'],['Publicidade e parcerias','Conteúdos patrocinados e links de afiliados, quando presentes, devem ser identificados. Esta versão não contém anúncios ativos ou links com comissão.'],['Correções','Encontrou um erro? Envie o título do artigo e a correção sugerida para contato@outlet3d.com.br.']]},
 privacidade:{title:'Privacidade',lead:'Como esta versão do site funciona.',sections:[['Navegação','Esta versão não possui cadastro, formulário de coleta de dados, ferramentas de análise ou anúncios ativos. A hospedagem pode processar dados técnicos de acesso para operar o serviço.'],['Serviços externos','As imagens são carregadas do Unsplash e as fontes do Google Fonts. Ao carregar esses recursos, seu navegador se conecta a esses fornecedores, que podem receber dados técnicos como o endereço IP.'],['Contato por e-mail','Ao enviar uma mensagem, você compartilha os dados incluídos no e-mail, usados para responder à sua solicitação. Para questões sobre privacidade, escreva para contato@outlet3d.com.br.'],['Atualizações','Esta página deverá ser atualizada quando forem integrados anúncios, análise de audiência ou outros serviços de coleta de dados.']]},
 termos:{title:'Termos de uso',lead:'Orientações para aproveitar o conteúdo da Outlet 3D.',sections:[['Finalidade educativa','O conteúdo tem caráter informativo. Confira a compatibilidade de equipamentos, materiais e configurações antes de aplicar um procedimento.'],['Uso responsável','Siga as orientações do fabricante e respeite as licenças de modelos digitais. Projetos com função estrutural ou de segurança exigem avaliação específica.'],['Contato','Dúvidas e solicitações podem ser encaminhadas para contato@outlet3d.com.br.']]}
};
export function getStaticPaths(){return ['sobre','autor','contato','transparencia','privacidade','termos'].map(page=>({params:{page}}))}
const key=Astro.params.page as keyof typeof pages;const page=pages[key];
---
<Layout title={page.title} description={page.lead}><div class="document"><div class="breadcrumb"><a href="/">Início</a> / {page.title}</div><p class="eyebrow">OUTLET 3D</p><h1>{page.title}</h1><p class="lead">{page.lead}</p>{page.sections.map(([heading,body])=><section><h2>{heading}</h2><p>{body}</p></section>)}{key==='autor'&&<p><a href="https://www.linkedin.com/in/erickonunes/" target="_blank" rel="noopener noreferrer">Erick Nunes no LinkedIn ↗</a></p>}<p><a href="mailto:contato@outlet3d.com.br">contato@outlet3d.com.br ↗</a></p></div></Layout>
