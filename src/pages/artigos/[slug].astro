---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { articles, photos, categorySlug } from '../../data/articles';
import '../../styles/editorial.css';
import '../../styles/author-card.css';

export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}))}
const {article}=Astro.props;
const sameCategory=articles.filter(item=>item.category===article.category);
const currentIndex=sameCategory.findIndex(item=>item.slug===article.slug);
const previous=sameCategory[currentIndex-1] ?? articles[articles.findIndex(item=>item.slug===article.slug)-1];
const next=sameCategory[currentIndex+1] ?? articles[articles.findIndex(item=>item.slug===article.slug)+1];
const related=articles.filter(item=>item.slug!==article.slug&&item.slug!==previous?.slug&&item.slug!==next?.slug).slice(0,2);
const links=[previous&&{...previous,label:`← Artigo anterior: ${previous.title}`},...related.map(item=>({...item,label:item.title})),next&&{...next,label:`Próximo artigo: ${next.title} →`}].filter(Boolean);
const articleSeo={description:article.description,ogType:'article',canonical:`https://outlet3d.com.br/artigos/${article.slug}/`,schemas:[{'@context':'https://schema.org','@type':'BlogPosting',headline:article.title,description:article.description,image:photos[article.image],mainEntityOfPage:`https://outlet3d.com.br/artigos/${article.slug}/`,author:{'@type':'Person',name:'Erick Nunes',url:'https://outlet3d.com.br/autor/'},publisher:{'@id':'https://outlet3d.com.br/#organization'},inLanguage:'pt-BR'},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Início',item:'https://outlet3d.com.br/'},{'@type':'ListItem',position:2,name:article.category,item:`https://outlet3d.com.br/categoria/${categorySlug(article.category)}/`},{'@type':'ListItem',position:3,name:article.title,item:`https://outlet3d.com.br/artigos/${article.slug}/`}]}]};
---
<Layout title={article.title} seo={articleSeo}><main class="post-page"><header class="post-hero"><div class="post-hero-inner"><div class="breadcrumb"><a href="/">Início</a> / <a href={`/categoria/${categorySlug(article.category)}/`}>{article.category}</a></div><span class="category">{article.category}</span><h1>{article.title}</h1><p>{article.description}</p><div class="post-byline"><a href="/autor/" class="post-avatar">EN</a><span>Por <a href="/autor/">Erick Nunes</a><small>Outlet 3D · {article.time} min de leitura</small></span></div></div><img src={photos[article.image]} alt="Processo de impressão 3D" width="1200" height="700" fetchpriority="high"/></header><div class="post-layout"><aside class="post-toc"><p>NESTE GUIA</p>{article.sections.map(([heading],i)=><a href={`#etapa-${i}`}><span>{String(i+1).padStart(2,'0')}</span><span>{heading}</span></a>)}</aside><article class="post-content">{article.sections.map(([heading,body],i)=><><section id={`etapa-${i}`}><span class="post-section-number">{String(i+1).padStart(2,'0')}</span><h2>{heading}</h2><p>{body}</p></section>{(i===1 || (article.sections.length===1 && i===0)) && <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_ARTICLE_SLOT}/>}</>)}<aside class="post-author"><div class="post-author-photo"><img src="/wp-content/uploads/2024/01/ErickNunes.webp" alt="Erick Nunes" width="512" height="512" loading="lazy"/><span>EN</span></div><div><p class="eyebrow">AUTOR & ESPECIALISTA</p><h2>Erick Nunes</h2><p class="post-author-role">Engenharia mecânica · Fabricação aditiva</p><p>Erick transforma tecnologia complexa em conhecimento prático para quem quer projetar, testar e criar com impressão 3D.</p><a href="/autor/">Conheça a trajetória de Erick <span>↗</span></a></div></aside><section class="related-articles manual-related"><p class="eyebrow">CONTINUE EXPLORANDO</p><h2>Continue por conteúdos relacionados.</h2>{links.map(item=><a href={`/artigos/${item.slug}/`}>{item.label} <span>↗</span></a>)}</section><a class="post-back" href={`/categoria/${categorySlug(article.category)}/`}>← Ver todos os artigos desta categoria</a></article></div></main></Layout>
