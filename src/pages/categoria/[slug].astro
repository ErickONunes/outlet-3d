---
import Layout from '../../layouts/Layout.astro';
import { allCategories, getCategoryEntries, getPageCount, POSTS_PER_PAGE, type ArchiveCategory } from '../../data/categoryArchive';
import '../../styles/editorial.css';
import '../../styles/archive-cards.css';
import '../../styles/pagination.css';
export function getStaticPaths(){return allCategories.map(category=>({params:{slug:category.slug},props:{category}}))}
const {category}=Astro.props as {category:ArchiveCategory};
const allEntries=getCategoryEntries(category);
const entries=allEntries.slice(0,POSTS_PER_PAGE);
const pageCount=getPageCount(allEntries.length);
const categorySeo={description:`Artigos sobre ${category.name}: guias, ideias e aplicações práticas de impressão 3D da Outlet 3D.`,canonical:`https://outlet3d.com.br/categoria/${category.slug}/`,schemas:[{'@context':'https://schema.org','@type':'CollectionPage',name:category.name,description:`Artigos sobre ${category.name} na Outlet 3D.`,url:`https://outlet3d.com.br/categoria/${category.slug}/`,inLanguage:'pt-BR',isPartOf:{'@id':'https://outlet3d.com.br/#website'},mainEntity:{'@type':'ItemList',numberOfItems:entries.length,itemListElement:entries.map((entry,index)=>({'@type':'ListItem',position:index+1,url:`https://outlet3d.com.br${entry.path}`,name:entry.title}))}}]};
---
<Layout title={`${category.name} | Outlet 3D`} seo={categorySeo}><main class="archive-page"><section class="archive-hero"><p class="eyebrow"><span></span> ARQUIVO OUTLET 3D</p><div><h1>{category.name}</h1><p>Conteúdo para entender melhor, criar com mais confiança e descobrir novas possibilidades na impressão 3D.</p></div><span class="archive-count">{String(allEntries.length).padStart(2,'0')}<small>ARTIGOS</small></span></section><section class="archive-content"><div class="archive-toolbar"><p>Conteúdos selecionados para a sua próxima camada.</p><a href="/">← Voltar à página inicial</a></div><div class="archive-grid">{entries.map((entry,index)=><article class={index===0?'archive-card archive-card-featured':'archive-card'}><a class="archive-image" href={entry.path}>{entry.cover ? <img src={entry.cover.src} alt={entry.cover.alt} width={entry.cover.width} height={entry.cover.height} loading={index===0?'eager':'lazy'}/> : <span class="archive-image-placeholder" aria-hidden="true">OUTLET 3D</span>}<span>↗</span></a><div><p class="category">{entry.category}</p><h2><a href={entry.path}>{entry.title}</a></h2><p>{entry.description}</p><div class="archive-meta">{entry.author} <span>· {entry.time} min de leitura</span></div></div></article>)}</div>{pageCount > 1 && <nav class="archive-pagination" aria-label="Paginação de artigos"><span>Página 1 de {pageCount}</span>{Array.from({length:pageCount},(_,index)=><a class:list={{current:index===0}} href={index===0?`/categoria/${category.slug}/`:`/categoria/${category.slug}/pagina/${index+1}/`} aria-current={index===0?'page':undefined}>{index+1}</a>)}<a class="pagination-next" href={`/categoria/${category.slug}/pagina/2/`}>Próxima <span>→</span></a></nav>}</section><section class="archive-cta"><p class="eyebrow">QUER COMEÇAR?</p><h2>Seu primeiro projeto pode começar hoje.</h2><a href="/artigos/primeira-impressao-3d/">Ver guia para iniciantes <span>↗</span></a></section></main></Layout>
