---
import Layout from '../../layouts/Layout.astro';
import { articles, categories, categorySlug, photos } from '../../data/articles';
import migrated from '../../data/migrated.json';
import '../../styles/editorial.css';
import '../../styles/archive-cards.css';
const sourceCategories=Array.from(new Map(migrated.filter(item=>item.kind==='post').flatMap(item=>item.categories).map((category:any)=>[category.slug,category])).values()) as {name:string;slug:string;url:string}[];
const editorialCategories=categories.map(name=>({name,slug:categorySlug(name),url:`/categoria/${categorySlug(name)}/`}));
const allCategories=[...editorialCategories.filter(editorial=>!sourceCategories.some(category=>category.name===editorial.name)),...sourceCategories];
export function getStaticPaths(){const sourceCategories=Array.from(new Map(migrated.filter(item=>item.kind==='post').flatMap(item=>item.categories).map((category:any)=>[category.slug,category])).values()) as {name:string;slug:string;url:string}[];const editorialCategories=categories.map(name=>({name,slug:categorySlug(name),url:`/categoria/${categorySlug(name)}/`}));const allCategories=[...editorialCategories.filter(editorial=>!sourceCategories.some(category=>category.name===editorial.name)),...sourceCategories];return allCategories.map(category=>({params:{slug:category.slug},props:{category}}))}
const {category}=Astro.props as {category:{name:string;slug:string;url:string}};
const selected=articles.filter(article=>article.category===category.name);
const migratedPosts=migrated.filter(item=>item.kind==='post' && item.categories.some((itemCategory:any)=>itemCategory.slug===category.slug || itemCategory.name===category.name));
const summary=(text:string,limit=140)=>text.replace(/\s+/g,' ').trim().slice(0,limit).replace(/\s+\S*$/,'')+'…';
const entries=[...migratedPosts.map(item=>({path:item.path,title:item.title,description:summary(item.excerpt||item.seo.description),cover:item.cover,author:item.author,time:item.readingMinutes,category:category.name})),...selected.map(item=>({path:`/artigos/${item.slug}/`,title:item.title,description:item.description,cover:{src:photos[item.image],alt:'Impressora 3D em funcionamento',width:800,height:550},author:'Erick Nunes',time:item.time,category:item.category}))].sort((a,b)=>a.title.localeCompare(b.title,'pt-BR'));
const categorySeo={description:`Artigos sobre ${category.name}: guias, ideias e aplicações práticas de impressão 3D da Outlet 3D.`,canonical:`https://outlet3d.com.br/categoria/${category.slug}/`,schemas:[{'@context':'https://schema.org','@type':'CollectionPage',name:category.name,description:`Artigos sobre ${category.name} na Outlet 3D.`,url:`https://outlet3d.com.br/categoria/${category.slug}/`,inLanguage:'pt-BR',isPartOf:{'@id':'https://outlet3d.com.br/#website'},mainEntity:{'@type':'ItemList',numberOfItems:entries.length,itemListElement:entries.map((entry,index)=>({'@type':'ListItem',position:index+1,url:`https://outlet3d.com.br${entry.path}`,name:entry.title}))}}]};
---
<Layout title={`${category.name} | Outlet 3D`} seo={categorySeo}><main class="archive-page"><section class="archive-hero"><p class="eyebrow"><span></span> ARQUIVO OUTLET 3D</p><div><h1>{category.name}</h1><p>Conteúdo para entender melhor, criar com mais confiança e descobrir novas possibilidades na impressão 3D.</p></div><span class="archive-count">{String(entries.length).padStart(2,'0')}<small>ARTIGOS</small></span></section><section class="archive-content"><div class="archive-toolbar"><p>Conteúdos selecionados para a sua próxima camada.</p><a href="/">← Voltar à página inicial</a></div><div class="archive-grid">{entries.map((entry,index)=><article class={index===0?'archive-card archive-card-featured':'archive-card'}><a class="archive-image" href={entry.path}>{entry.cover ? <img src={entry.cover.src} alt={entry.cover.alt} width={entry.cover.width} height={entry.cover.height} loading={index===0?'eager':'lazy'}/> : <span class="archive-image-placeholder" aria-hidden="true">OUTLET 3D</span>}<span>↗</span></a><div><p class="category">{entry.category}</p><h2><a href={entry.path}>{entry.title}</a></h2><p>{entry.description}</p><div class="archive-meta">{entry.author} <span>· {entry.time} min de leitura</span></div></div></article>)}</div></section><section class="archive-cta"><p class="eyebrow">QUER COMEÇAR?</p><h2>Seu primeiro projeto pode começar hoje.</h2><a href="/artigos/primeira-impressao-3d/">Ver guia para iniciantes <span>↗</span></a></section></main></Layout>
