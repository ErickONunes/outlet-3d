---
import '../styles/global.css';
import {categories,categorySlug} from '../data/articles';
const {title='Impressão 3D, ideias e possibilidades', description='Guias, materiais e ideias criativas para transformar seus projetos com impressão 3D.'} = Astro.props;
const path=Astro.url.pathname;
const adClient=import.meta.env.PUBLIC_ADSENSE_CLIENT;
const adsEnabled=import.meta.env.PUBLIC_ADSENSE_ENABLED==='true' && /^ca-pub-\d{16}$/.test(adClient || '');
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Outlet 3D</title><meta name="description" content={description}/><link rel="canonical" href={new URL(path,'https://outlet3d.com.br')}/><meta property="og:title" content={`${title} | Outlet 3D`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta name="theme-color" content="#163d30"/><link rel="icon" href="/favicon.svg"/>{adsEnabled && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`} crossorigin="anonymous"></script>}<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'Outlet 3D',url:'https://outlet3d.com.br',email:'contato@outlet3d.com.br'})}/></head><body><a class="skip" href="#conteudo">Pular para o conteúdo</a><div class="topline"><div>IDEIAS QUE GANHAM FORMA.<span>Seu próximo projeto começa aqui ↗</span></div></div><header><div class="header-inner"><a class="logo" href="/" aria-label="Outlet 3D, início"><span class="logo-mark">◈</span>outlet<span class="logo-3d">3D</span><span class="logo-dot">.</span></a><nav aria-label="Principal"><a class:list={{active:path==='/'}} href="/">Início</a><a href="/categoria/guias-tutoriais/">Guias & Tutoriais</a><a href="/categoria/universo-3d/">Universo 3D</a><a href="/categoria/design-criatividade/">Design & Criatividade</a><a href="/sobre/">Sobre</a></nav><a class="header-cta" href="/artigos/primeira-impressao-3d/">Comece por aqui <span>↗</span></a></div></header><main id="conteudo"><slot/></main><footer><div class="footer-grid"><div><a class="logo" href="/">◈ outlet<span class="logo-3d">3D</span>.</a><p>Transformando ideias em realidade,<br/>uma camada de cada vez.</p></div><div><strong>Explore o universo 3D</strong>{categories.map(c=><a href={`/categoria/${categorySlug(c)}/`}>{c}</a>)}</div><div><strong>Outlet 3D</strong><a href="/sobre/">Sobre nós</a><a href="/autor/">Erick Nunes</a><a href="/contato/">Contato</a><a href="/transparencia/">Transparência editorial</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Outlet 3D</span><div><a href="/privacidade/">Privacidade</a><a href="/termos/">Termos de uso</a></div></div></footer></body></html>
