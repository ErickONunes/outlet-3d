---
import '../styles/global.css';
import '../styles/header-glass.css';
import '../styles/mobile-first.css';
import '../styles/reading-navigation.css';
import '../styles/interactive-states.css';
import '../styles/about-author-portfolio.css';
import { categories, categorySlug } from '../data/articles';

const { title = 'Impressão 3D, ideias e possibilidades', description = 'Guias, materiais e ideias criativas para transformar seus projetos com impressão 3D.' } = Astro.props;
const path = Astro.url.pathname;
const seo = Astro.props.seo;
const documentTitle = seo?.title ?? (title.includes('Outlet 3D') ? title : `${title} | Outlet 3D`);
const documentDescription = seo ? seo.description : description;
const canonical = seo?.canonical ?? new URL(path, 'https://outlet3d.com.br').href;
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const adsEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true' && /^ca-pub-\d{16}$/.test(adClient || '');
const organizationSchema = {'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':'https://outlet3d.com.br/#organization',name:'Outlet 3D',url:'https://outlet3d.com.br/',logo:'https://outlet3d.com.br/branding/logo-outlet-3d-black.png',email:'contato@outlet3d.com.br',sameAs:['https://www.linkedin.com/in/erickonunes/']},{'@type':'WebSite','@id':'https://outlet3d.com.br/#website',url:'https://outlet3d.com.br/',name:'Outlet 3D',inLanguage:'pt-BR',publisher:{'@id':'https://outlet3d.com.br/#organization'}}]};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    {documentDescription && <meta name="description" content={documentDescription} />}
    <meta name="author" content="Erick Nunes" />
    <meta name="publisher" content="Outlet 3D" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={seo?.ogTitle ?? documentTitle} />
    {(seo?.ogDescription ?? documentDescription) && <meta property="og:description" content={seo?.ogDescription ?? documentDescription} />}
    <meta property="og:type" content={seo?.ogType ?? 'website'} />
    <meta property="og:url" content={canonical} />
    {seo?.robots && <meta name="robots" content={seo.robots} />}
    {seo?.extraMeta && Object.entries(seo.extraMeta).map(([key, value]) => key.startsWith('twitter:') ? <meta name={key} content={String(value)} /> : <meta property={key} content={String(value)} />)}
    {seo?.schemas?.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema).replace(/</g, '\\u003c')} />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" href="/favicon.svg" />
    {adsEnabled && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`} crossorigin="anonymous"></script>}
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <div class="topline"><div>IDEIAS QUE GANHAM FORMA.<span>Seu próximo projeto começa aqui ↗</span></div></div>
    <header class="site-header" data-site-header>
      <div class="header-inner">
        <a class="logo" href="/" aria-label="Outlet 3D, início"><img src="/branding/logo-outlet-3d-black.png" alt="Outlet 3D" width="1001" height="228" /></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle><span class="sr-only">Abrir menu</span><span></span><span></span><span></span></button>
        <nav id="site-navigation" aria-label="Principal" data-site-navigation>
          <a class:list={{active:path==='/'}} href="/">Início</a><a href="/categoria/impressao-3d/">Impressão 3D</a><a href="/categoria/guias-tutoriais/">Guias & Tutoriais</a><a href="/categoria/universo-3d/">Universo 3D</a><a href="/categoria/design-criatividade/">Design & Criatividade</a><a href="/recomendados/">Recomendações</a><a href="/sobre/">Sobre</a>
          <a class="menu-mobile-cta" href="/artigos/primeira-impressao-3d/">Comece por aqui <span>↗</span></a>
        </nav>
        <a class="header-cta" href="/artigos/primeira-impressao-3d/">Comece por aqui <span>↗</span></a>
      </div>
    </header>
    <main id="conteudo"><slot /></main>
    <footer><div class="footer-grid"><div><a class="logo footer-logo" href="/"><img src="/branding/logo-outlet-3d-white.png" alt="Outlet 3D" width="1001" height="228" /></a><p>Transformando ideias em realidade,<br/>uma camada de cada vez.</p></div><div><strong>Explore o universo 3D</strong>{categories.map((c) => <a href={`/categoria/${categorySlug(c)}/`}>{c}</a>)}</div><div><strong>Outlet 3D</strong><a href="/recomendados/">Recomendações</a><a href="/sobre/">Sobre nós</a><a href="/autor/">Erick Nunes</a><a href="/contato/">Contato</a><a href="/transparencia/">Transparência editorial</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Outlet 3D</span><div><a href="/politica-de-privacidade/">Privacidade</a><a href="/termos-de-uso/">Termos de uso</a><a href="/politica-de-cookies-br/">Cookies</a><a href="/aviso-legal/">Aviso legal</a></div></div></footer>
    <script is:inline>
      const header = document.querySelector('[data-site-header]');
      const toggle = document.querySelector('[data-menu-toggle]');
      const navigation = document.querySelector('[data-site-navigation]');
      const setMenu = (open) => { header?.classList.toggle('menu-open', open); toggle?.setAttribute('aria-expanded', String(open)); document.body.classList.toggle('menu-is-open', open); };
      toggle?.addEventListener('click', () => setMenu(!header?.classList.contains('menu-open')));
      navigation?.addEventListener('click', (event) => { if (event.target.closest('a')) setMenu(false); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
      window.addEventListener('resize', () => { if (window.innerWidth > 760) setMenu(false); });
      const aboutAuthor = document.querySelector('.about-author-copy');
      if (aboutAuthor && !aboutAuthor.querySelector('.about-portfolio-link')) {
        const portfolioLink = document.createElement('a');
        portfolioLink.className = 'about-portfolio-link';
        portfolioLink.href = '/autor/';
        portfolioLink.innerHTML = 'Ver portfólio de Erick <span>↗</span>';
        const linkedinLink = aboutAuthor.querySelector('.about-link');
        const actions = document.createElement('div');
        actions.className = 'about-author-actions';
        linkedinLink?.before(actions);
        if (linkedinLink) actions.append(linkedinLink);
        actions.append(portfolioLink);
      }
    </script>
  </body>
</html>
